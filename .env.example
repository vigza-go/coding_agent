DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/langchain?charset=utf8mb4
CHECKPOINT_DATABASE_URL=mysql://root:password@127.0.0.1:3306/langchain?charset=utf8mb4
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash[1M]
# 摘要/压缩专用模型（可选）。留空则复用 LLM_*；thinking 默认 disabled（无思考链）。
SUMMARY_LLM_MODEL=qwen3.7-flash
SUMMARY_LLM_MAX_OUTPUT_TOKENS=4000
SUMMARY_LLM_THINKING=disabled
WORKSPACE_ROOT=.
ARTIFACT_DIR=.artifacts
AGENT_BASH_ENABLED=true
AGENT_BASH_EXECUTABLE=/bin/bash
AGENT_BASH_TIMEOUT_SECONDS=120
AGENT_BASH_MAX_OUTPUT_BYTES=100000
AGENT_NOTIFICATIONS_ENABLED=true
AGENT_PREVENT_SLEEP=true
AGENT_USAGE_RECENT_MESSAGES=20
